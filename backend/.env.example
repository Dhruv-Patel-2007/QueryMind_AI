# QueryMind AI 2.0 - Backend Environment Configuration Template
PROJECT_NAME="QueryMind AI 2.0"
VERSION="2.0.0"
API_V1_STR="/api"
ENVIRONMENT="development"
DEBUG=true

# Server Settings
HOST="127.0.0.1"
PORT=8000

# CORS Configuration (Comma-separated list of origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (Academic Institution SQLite)
DATABASE_URL="sqlite:///./data/academic.db"

# Context Engine Settings
CONTEXT_TTL_SECONDS=600

